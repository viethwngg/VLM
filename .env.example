GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when a model returns 404 or 503. Leave empty to disable fallback.
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash-lite
# Total attempts per operation, including the initial request.
GEMINI_MAX_ATTEMPTS=5
GEMINI_RETRY_DELAY_SECONDS=10
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=hash-384
EMBEDDING_DIMENSION=384
